# Payroll service environment (copy to .env for local development)
NODE_ENV=development
PORT=3005

# Postgres (own logical database per service — no shared DB)
DATABASE_URL=postgres://novapay:novapay@localhost:5432/payroll_db

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# Queue used by worker.ts (leave empty to disable the worker outside Docker)
QUEUE_NAME=payroll

# Dependency service URLs
TRANSACTION_SERVICE_URL=http://transaction-service:3002
