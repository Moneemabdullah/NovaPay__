# Admin service environment (copy to .env for local development)
NODE_ENV=development
PORT=3006

# Postgres (own logical database per service — no shared DB)
DATABASE_URL=postgres://novapay:novapay@localhost:5432/admin_db

# Dependency service URLs
LEDGER_SERVICE_URL=http://ledger-service:3003
# Service identity for internal calls (dev defaults only; rotate in production)
SERVICE_ID=admin-service
SERVICE_TOKEN=novapay-dev-admin-token
PEER_API_GATEWAY_TOKEN=novapay-dev-gateway-token

