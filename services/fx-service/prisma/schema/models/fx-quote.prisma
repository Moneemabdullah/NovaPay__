model FxQuote {
  id                  String    @id @default(uuid()) @db.Uuid
  baseCurrency        String    @map("base_currency") @db.Char(3)
  quoteCurrency       String    @map("quote_currency") @db.Char(3)
  rate                Decimal   @db.Decimal(18, 8)
  provider            String    @default("static-development-provider")
  issuedAt            DateTime  @default(now()) @map("issued_at")
  expiresAt           DateTime  @map("expires_at")
  used                Boolean   @default(false)
  usedAt              DateTime? @map("used_at")
  status              String    @default("active")
  usedByTransactionId String?   @map("used_by_transaction_id") @db.Uuid

  @@index([expiresAt])
  @@map("fx_quotes")
}