# FX service environment (copy to .env for local development)
NODE_ENV=development
PORT=3004

# Postgres (own logical database per service — no shared DB)
DATABASE_URL=postgres://novapay:novapay@localhost:5432/fx_db

# Set to "true" to simulate the third-party FX provider being unavailable
FX_PROVIDER_DOWN=false
# Service identity for internal calls (dev defaults only; rotate in production)
SERVICE_ID=fx-service
SERVICE_TOKEN=novapay-dev-fx-token
PEER_TRANSACTION_SERVICE_TOKEN=novapay-dev-transaction-token
PEER_API_GATEWAY_TOKEN=novapay-dev-gateway-token

