# Transaction service environment (copy to .env for local development)
NODE_ENV=development
PORT=3002

# Postgres (own logical database per service — no shared DB)
DATABASE_URL=postgres://novapay:novapay@localhost:5432/transaction_db

# Dependency service URLs
ACCOUNT_SERVICE_URL=http://account-service:3001
LEDGER_SERVICE_URL=http://ledger-service:3003
FX_SERVICE_URL=http://fx-service:3004
