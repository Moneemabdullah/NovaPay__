# Account service environment (copy to .env for local development)
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Postgres (own logical database per service — no shared DB)
DATABASE_URL=postgres://novapay:novapay@localhost:5432/account_db

# Secret used to derive the Key Encryption Key (KEK) for field-level encryption.
# Use a strong random secret in production; never commit a real value.
FIELD_ENCRYPTION_KEK=local-development-kek-only-change-me
