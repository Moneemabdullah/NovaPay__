# Ledger service environment (copy to .env for local development)
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Postgres (own logical database per service — no shared DB)
DATABASE_URL=postgres://novapay:novapay@localhost:5432/ledger_db
# Service identity for internal calls (dev defaults only; rotate in production)
SERVICE_ID=ledger-service
SERVICE_TOKEN=novapay-dev-ledger-token
PEER_TRANSACTION_SERVICE_TOKEN=novapay-dev-transaction-token
PEER_ADMIN_SERVICE_TOKEN=novapay-dev-admin-token
PEER_API_GATEWAY_TOKEN=novapay-dev-gateway-token

