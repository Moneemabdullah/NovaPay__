# Root environment (used when running the whole stack outside Docker Compose).
# For per-service configuration, see each service's .env.example:
#   services/api-gateway/.env.example
#   services/account-service/.env.example
#   services/transaction-service/.env.example
#   services/ledger-service/.env.example
#   services/fx-service/.env.example
#   services/payroll-service/.env.example
#   services/admin-service/.env.example

NODE_ENV=development

# Postgres (local, outside Docker). Each service uses its own logical database:
#   account_db, transaction_db, ledger_db, fx_db, payroll_db, admin_db
DATABASE_URL=postgres://novapay:novapay@localhost:5432

# Redis
REDIS_URL=redis://localhost:6379

# FX provider availability toggles
FX_PROVIDER_DOWN=false
